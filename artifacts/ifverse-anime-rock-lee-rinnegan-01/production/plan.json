  "enhancement": "anime-light",
  "source_credit": "IFVERSE ANIME / FAN-MADE WHAT-IF",
  "publishing_authorized": false,
  "narration_sha256": "544dbccf6f4e17af9b4c20f8752aeb7f4c1bbb0a88141876b76b1f452155c98c",
  "caption_segments": [
    {
      "start": 0,
      "end": 0.84,
      "text": "What if Rock Lee woke"
    },
    {
      "start": 0.84,
      "end": 2.06,
      "text": "up with the Rinnegan?"
    },
    {
      "start": 2.06,
      "end": 3.32,
      "text": "The character creator just lost"
    },
    {
      "start": 3.32,
      "end": 5.66,
      "text": "its damn mind completely. This is a fan -made"
    },
    {
      "start": 5.66,
      "end": 7.26,
      "text": "upgrade, not canon."
    },
    {
      "start": 7.26,
      "end": 8.56,
      "text": "Lee gets gravity powers before"
    },
    {
      "start": 8.56,
      "end": 10.58,
      "text": "he gets an instruction manual."
    },
    {
      "start": 10.58,
      "end": 12.0,
      "text": "Excellent parenting, universe."
    },
    {
      "start": 12.0,
      "end": 13.58,
      "text": "He tries a normal warm -up."
    },
    {
      "start": 13.58,
      "end": 14.7,
      "text": "The training weights fly toward"
    },
    {
      "start": 14.7,
      "end": 15.86,
      "text": "his face."
    },
    {
      "start": 15.86,
      "end": 17.06,
      "text": "Brother ordered express shipping on"
    },
    {
      "start": 17.06,
      "end": 18.013025529832372,
      "text": "his own concussion."
    },
    {
      "start": 18.013025529832372,
      "end": 18.993,
      "text": "Guy says the power of"
    },
    {
      "start": 18.993,
      "end": 20.553,
      "text": "youth requires control."
    },
    {
      "start": 20.553,
      "end": 22.153,
      "text": "Sir, your student just magnetized"
    },
    {
      "start": 22.153,
      "end": 23.113,
      "text": "the furniture."
    },
    {
      "start": 23.113,
      "end": 24.493,
      "text": "Start with eye safety."
    },
    {
      "start": 24.493,
      "end": 25.573,
      "text": "Having the eyes wouldn't instantly"
    },
    {
      "start": 25.573,
      "end": 27.133,
      "text": "teach every technique."
    },
    {
      "start": 27.133,
      "end": 28.833,
      "text": "Chakra demand and concentration still"
    },
    {
      "start": 28.833,
      "end": 29.853,
      "text": "matter."
    },
    {
      "start": 29.853,
      "end": 32.333,
      "text": "Premium hardware, zero installed drivers."
    },
    {
      "start": 32.333,
      "end": 33.693,
      "text": "Lee experiments with pulling opponents"
    },
    {
      "start": 33.693,
      "end": 35.453,
      "text": "off balance before a kick."
    },
    {
      "start": 35.453,
      "end": 36.573,
      "text": "Strong idea."
    },
    {
      "start": 36.573,
      "end": 37.533,
      "text": "Horrific first day for the"
    },
    {
      "start": 37.533,
      "end": 38.322668967369346,
      "text": "practice dummy."
    },
    {
      "start": 38.322668967369346,
      "end": 39.4026875,
      "text": "Then he realizes the harder"
    },
    {
      "start": 39.4026875,
      "end": 41.7826875,
      "text": "lesson: when teammates stand nearby,"
    },
    {
      "start": 41.7826875,
      "end": 42.842687500000004,
      "text": "a wild push can hurt"
    },
    {
      "start": 42.842687500000004,
      "end": 44.1026875,
      "text": "the people he's protecting."
    },
    {
      "start": 44.1026875,
      "end": 45.6426875,
      "text": "So Guy sets a challenge."
    },
    {
      "start": 45.6426875,
      "end": 46.6226875,
      "text": "Move one falling leaf with"
    },
    {
      "start": 46.6226875,
      "end": 47.482687500000004,
      "text": "the new power."
    },
    {
      "start": 47.482687500000004,
      "end": 48.342687500000004,
      "text": "Not the tree."
    },
    {
      "start": 48.342687500000004,
      "end": 49.2026875,
      "text": "Not the neighborhood."
    },
    {
      "start": 49.2026875,
      "end": 50.7026875,
      "text": "Lee struggles because precision doesn't"
    },
    {
      "start": 50.7026875,
      "end": 52.2026875,
      "text": "care how inspirational your speech"
    },
    {
      "start": 52.2026875,
      "end": 53.2026875,
      "text": "sounds."
    },
    {
      "start": 53.2026875,
      "end": 54.7426875,
      "text": "The leaf remains deeply unimpressed"
    },
    {
      "start": 54.7426875,
      "end": 55.802687500000005,
      "text": "by his grindset."
    },
    {
      "start": 55.802687500000005,
      "end": 56.842687500000004,
      "text": "He stops chasing the biggest"
    },
    {
      "start": 56.842687500000004,
      "end": 58.4626875,
      "text": "attack and uses tiny pulls"
    },
    {
      "start": 58.4626875,
      "end": 60.0626875,
      "text": "to create openings."
    },
    {
      "start": 60.0626875,
      "end": 61.2426875,
      "text": "The punches finally have a"
    },
    {
      "start": 61.2426875,
      "end": 61.92298880997561,
      "text": "group chat."
    },
    {
      "start": 61.92298880997561,
      "end": 63.263000000000005,
      "text": "When a teammate falls, Lee"
    },
    {
      "start": 63.263000000000005,
      "end": 64.723,
      "text": "catches them with controlled force"
    },
    {
      "start": 64.723,
      "end": 66.023,
      "text": "instead of flexing."
    },
    {
      "start": 66.023,
      "end": 67.10300000000001,
      "text": "That rescue is the actual"
    },
    {
      "start": 67.10300000000001,
      "end": 68.023,
      "text": "upgrade here."
    },
    {
      "start": 68.023,
      "end": 69.543,
      "text": "Guy cries with pride."
    },
    {
      "start": 69.543,
      "end": 70.683,
      "text": "Lee cries too."
    },
    {
      "start": 70.683,
      "end": 72.16300000000001,
      "text": "The leaf floats perfectly."
    },
    {
      "start": 72.16300000000001,
      "end": 73.303,
      "text": "Three episodes of training, and"
    },
    {
      "start": 73.303,
      "end": 74.983,
      "text": "the final boss was landscaping."
    }
  ]
}

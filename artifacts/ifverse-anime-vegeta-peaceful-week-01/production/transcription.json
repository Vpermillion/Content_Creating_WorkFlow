  "captions": [
    {
      "start": 0,
      "end": 0.86,
      "text": "What if Vegeta got one"
    },
    {
      "start": 0.86,
      "end": 1.92,
      "text": "peaceful week?"
    },
    {
      "start": 1.92,
      "end": 2.92,
      "text": "No invasion."
    },
    {
      "start": 2.92,
      "end": 4.3,
      "text": "A prince underqualified for normal"
    },
    {
      "start": 4.3,
      "end": 5.5,
      "text": "Tuesday activities."
    },
    {
      "start": 5.5,
      "end": 7.9,
      "text": "He begins by training harder. Naturally."
    },
    {
      "start": 7.9,
      "end": 9.08,
      "text": "Bro treats relaxation like a"
    },
    {
      "start": 9.08,
      "end": 10.82,
      "text": "security vulnerability in his system."
    },
    {
      "start": 10.82,
      "end": 12.48,
      "text": "Bulma requests family time."
    },
    {
      "start": 12.48,
      "end": 13.96,
      "text": "Vegeta asks for the objective."
    },
    {
      "start": 13.96,
      "end": 15.64,
      "text": "Sir, the objective is being present."
    },
    {
      "start": 15.64,
      "end": 17.1,
      "text": "Trunks shows him a drawing."
    },
    {
      "start": 17.1,
      "end": 18.32,
      "text": "Vegeta corrects his stance."
    },
    {
      "start": 18.32,
      "end": 19.52,
      "text": "My guy, that's artwork, not"
    },
    {
      "start": 19.52,
      "end": 20.46721536351166,
      "text": "an enemy combatant."
    },
    {
      "start": 20.46721536351166,
      "end": 21.6471875,
      "text": "Without a threat, strength needs"
    },
    {
      "start": 21.6471875,
      "end": 22.6871875,
      "text": "another purpose."
    },
    {
      "start": 22.6871875,
      "end": 24.0871875,
      "text": "Can he enjoy people he protects?"
    },
    {
      "start": 24.0871875,
      "end": 25.0271875,
      "text": "Goku visits."
    },
    {
      "start": 25.0271875,
      "end": 27.3271875,
      "text": "Vegeta immediately suspects secret training."
    },
    {
      "start": 27.3271875,
      "end": 28.4271875,
      "text": "A friendly hello triggers a"
    },
    {
      "start": 28.4271875,
      "end": 29.7071875,
      "text": "competitive investigation."
    },
    {
      "start": 29.7071875,
      "end": 31.167187499999997,
      "text": "He wants gravity training again."
    },
    {
      "start": 31.167187499999997,
      "end": 32.4671875,
      "text": "Instead, he promises a short"
    },
    {
      "start": 32.4671875,
      "end": 33.8671875,
      "text": "session and leaves on time."
    },
    {
      "start": 33.8671875,
      "end": 34.9671875,
      "text": "Bulma is shocked."
    },
    {
      "start": 34.9671875,
      "end": 36.2271875,
      "text": "A grown man correctly estimated"
    },
    {
      "start": 36.2271875,
      "end": 37.6871875,
      "text": "his arrival time."
    },
    {
      "start": 37.6871875,
      "end": 39.107187499999995,
      "text": "Historic scenes at Capsule Corporation"
    },
    {
      "start": 39.107187499999995,
      "end": 39.813168724279834,
      "text": "today."
    },
    {
      "start": 39.813168724279834,
      "end": 40.8331875,
      "text": "He listens to Trunks explain"
    },
    {
      "start": 40.8331875,
      "end": 41.6731875,
      "text": "the drawing."
    },
    {
      "start": 41.6731875,
      "end": 42.5931875,
      "text": "It's their family."
    },
    {
      "start": 42.5931875,
      "end": 43.5931875,
      "text": "Nobody's fighting."
    },
    {
      "start": 43.5931875,
      "end": 44.6731875,
      "text": "Vegeta needs a moment."
    },
    {
      "start": 44.6731875,
      "end": 45.4731875,
      "text": "He keeps his pride, but"
    },
    {
      "start": 45.4731875,
      "end": 47.5331875,
      "text": "stops dodging tender conversations."
    },
    {
      "start": 47.5331875,
      "end": 49.0531875,
      "text": "An actual emotional upgrade."
    },
    {
      "start": 49.0531875,
      "end": 50.1531875,
      "text": "Goku asks if peace made"
    },
    {
      "start": 50.1531875,
      "end": 51.0131875,
      "text": "him soft."
    },
    {
      "start": 51.0131875,
      "end": 53.1331875,
      "text": "Vegeta schedules tomorrow's beating."
    },
    {
      "start": 53.1331875,
      "end": 55.4331875,
      "text": "Healthy boundaries, absolutely horrible phrasing."
    },
    {
      "start": 55.4331875,
      "end": 56.973187499999995,
      "text": "No new transformation appears."
    },
    {
      "start": 56.973187499999995,
      "end": 58.1531875,
      "text": "He still grows."
    },
    {
      "start": 58.1531875,
      "end": 59.2731875,
      "text": "Motherflicker, the breakthrough was dinner"
    },
    {
      "start": 59.2731875,
      "end": 60.973187499999995,
      "text": "together and one sincere compliment."
    }
  ],

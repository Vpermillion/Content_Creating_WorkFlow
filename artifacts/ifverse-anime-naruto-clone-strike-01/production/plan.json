  "scenes": [
    {
      "text": "What if Naruto's shadow clones went on strike? Bro got canceled by his own unpaid staff.",
      "label": "THE CLONES HAVE DEMANDS",
      "start": 0.0,
      "end": 4.4958417178799905,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-clones",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto multiplying through shadow clone technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Two hundred Narutos cross their arms. Same face, same trauma. Terrifying customer service.",
      "label": "TWO HUNDRED IDENTICAL COMPLAINTS",
      "start": 4.4958417178799905,
      "end": 9.551476957052431,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-clones",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto multiplying through shadow clone technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "He says, we're the same person. Exactly, boss. We know you'll volunteer us.",
      "label": "THE ORIGINAL IS CONFUSED",
      "start": 9.551476957052431,
      "end": 13.15514775037258,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Training stops. Missions fall behind. Konoha discovers its productivity plan was one exhausted teenager .",
      "label": "TRAINING IS NOW DELAYED",
      "start": 13.15514775037258,
      "end": 18.875537796079808,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-train",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto practicing a technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Kakashi looks up. He's never seen a meeting this orange.",
      "label": "MANAGEMENT HAS LOGGED OFF",
      "start": 18.875537796079808,
      "end": 21.534557022218944,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-kakashi",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Kakashi observing training; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "The clones explain that their painful memories return to Naruto. He's exploiting himself with extra steps.",
      "label": "MEMORIES COME BACK TOO",
      "start": 21.534557022218944,
      "end": 26.78262128433566,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-clones",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto multiplying through shadow clone technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "He proposes shorter rotations and actual breaks. Character development gets a lunch schedule attached.",
      "label": "AN ACTUAL CONCESSION",
      "start": 26.78262128433566,
      "end": 31.855750071048494,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Smaller squads test strategies before everyone commits. Fewer bodies, better information. An actual tactical upgrade appears.",
      "label": "SMALLER SQUAD SMARTER PLAN",
      "start": 31.855750071048494,
      "end": 38.62575296917906,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-train",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto practicing a technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "They still split his chakra. This union negotiates breaks, not a physics refund. Please stay serious.",
      "label": "THEY STILL SHARE CHAKRA",
      "start": 38.62575296917906,
      "end": 43.73386885097268,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-clones",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto multiplying through shadow clone technique; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Opponents now face coordinated scouts and decoys instead of orange dudes arguing over who gets punched.",
      "label": "THE ENEMY MEETS A TEAM",
      "start": 43.73386885097268,
      "end": 48.91195892292784,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-kakashi",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Kakashi observing training; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-kakashi",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Kakashi observing training; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "One clone asks who elected the original leader. Mother father. His entire forehead just lost confidence.",
      "label": "WHO APPROVED THE LEADER",
      "start": 48.91195892292784,
      "end": 54.29997156536767,
      "shots": [
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-naruto-clone-strike-01-naruto",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Naruto reacting to a disagreement; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {

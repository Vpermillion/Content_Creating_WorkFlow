  "captions": [
    {
      "start": 0,
      "end": 1.18,
      "text": "What if Naruto's shadow clones"
    },
    {
      "start": 1.18,
      "end": 2.42,
      "text": "went on strike?"
    },
    {
      "start": 2.42,
      "end": 3.32,
      "text": "Bro got canceled by his"
    },
    {
      "start": 3.32,
      "end": 4.56,
      "text": "own unpaid staff."
    },
    {
      "start": 4.56,
      "end": 5.8,
      "text": "Two hundred Narutos cross their"
    },
    {
      "start": 5.8,
      "end": 6.72,
      "text": "arms."
    },
    {
      "start": 6.72,
      "end": 8.22,
      "text": "Same face, same trauma."
    },
    {
      "start": 8.22,
      "end": 9.64,
      "text": "Terrifying customer service."
    },
    {
      "start": 9.64,
      "end": 10.32,
      "text": "He says, we're the same"
    },
    {
      "start": 10.32,
      "end": 11.12,
      "text": "person."
    },
    {
      "start": 11.12,
      "end": 12.04,
      "text": "Exactly, boss."
    },
    {
      "start": 12.04,
      "end": 13.24,
      "text": "We know you'll volunteer us."
    },
    {
      "start": 13.24,
      "end": 14.4,
      "text": "Training stops."
    },
    {
      "start": 14.4,
      "end": 15.6,
      "text": "Missions fall behind."
    },
    {
      "start": 15.6,
      "end": 17.22,
      "text": "Konoha discovers its productivity plan"
    },
    {
      "start": 17.22,
      "end": 18.94,
      "text": "was one exhausted teenager."
    },
    {
      "start": 18.94,
      "end": 19.94,
      "text": "Kakashi looks up."
    },
    {
      "start": 19.94,
      "end": 20.7,
      "text": "He's never seen a meeting"
    },
    {
      "start": 20.7,
      "end": 21.534557022218944,
      "text": "this orange."
    },
    {
      "start": 21.534557022218944,
      "end": 22.6545625,
      "text": "The clones explain that their"
    },
    {
      "start": 22.6545625,
      "end": 24.914562500000002,
      "text": "painful memories return to Naruto."
    },
    {
      "start": 24.914562500000002,
      "end": 26.1145625,
      "text": "He's exploiting himself with extra"
    },
    {
      "start": 26.1145625,
      "end": 26.8345625,
      "text": "steps."
    },
    {
      "start": 26.8345625,
      "end": 28.3945625,
      "text": "He proposes shorter rotations and"
    },
    {
      "start": 28.3945625,
      "end": 29.414562500000002,
      "text": "actual breaks."
    },
    {
      "start": 29.414562500000002,
      "end": 30.774562500000002,
      "text": "Character development gets a lunch"
    },
    {
      "start": 30.774562500000002,
      "end": 31.8945625,
      "text": "schedule attached."
    },
    {
      "start": 31.8945625,
      "end": 33.5345625,
      "text": "Smaller squads test strategies before"
    },
    {
      "start": 33.5345625,
      "end": 34.8545625,
      "text": "everyone commits."
    },
    {
      "start": 34.8545625,
      "end": 36.8745625,
      "text": "Fewer bodies, better information."
    },
    {
      "start": 36.8745625,
      "end": 38.6745625,
      "text": "An actual tactical upgrade appears."
    },
    {
      "start": 38.6745625,
      "end": 40.0745625,
      "text": "They still split his chakra."
    },
    {
      "start": 40.0745625,
      "end": 41.5545625,
      "text": "This union negotiates breaks, not"
    },
    {
      "start": 41.5545625,
      "end": 42.7145625,
      "text": "a physics refund."
    },
    {
      "start": 42.7145625,
      "end": 43.73386885097268,
      "text": "Please stay serious."
    },
    {
      "start": 43.73386885097268,
      "end": 45.333875,
      "text": "Opponents now face coordinated scouts"
    },
    {
      "start": 45.333875,
      "end": 46.933875,
      "text": "and decoys instead of orange"
    },
    {
      "start": 46.933875,
      "end": 49.013875,
      "text": "dudes arguing over who gets punched."
    },
    {
      "start": 49.013875,
      "end": 49.973875,
      "text": "One clone asks who elected"
    },
    {
      "start": 49.973875,
      "end": 51.433875,
      "text": "the original leader."
    },
    {
      "start": 51.433875,
      "end": 52.193875,
      "text": "Mother father."
    },
    {
      "start": 52.193875,
      "end": 53.493875,
      "text": "His entire forehead just lost"
    },
    {
      "start": 53.493875,
      "end": 54.373875,
      "text": "confidence."
    },
    {
      "start": 54.373875,
      "end": 56.213875,
      "text": "Naruto joins the strike."
    },
    {
      "start": 56.213875,
      "end": 57.513875,
      "text": "Everyone demands ramen."
    },
    {
      "start": 57.513875,
      "end": 59.533874999999995,
      "text": "Unfortunately, their revolutionary movement still"
    },
    {
      "start": 59.533874999999995,
      "end": 60.973875,
      "text": "shares exactly one wallet."
    }
  ],

      "start": 17.68,
      "end": 18.92,
      "text": "At first, the missions give"
    },
    {
      "start": 18.92,
      "end": 20.22,
      "text": "him the respect he always"
    },
    {
      "start": 20.22,
      "end": 20.58,
      "text": "wanted."
    },
    {
      "start": 21.04,
      "end": 22.32,
      "text": "But every favor comes with"
    },
    {
      "start": 22.32,
      "end": 22.7,
      "text": "a price."
    },
    {
      "start": 22.86,
      "end": 24.58,
      "text": "The breaking point arrives when"
    },
    {
      "start": 24.58,
      "end": 26.18,
      "text": "his new allies demand that"
    },
    {
      "start": 26.18,
      "end": 27.26,
      "text": "he turn against the Hidden"
    },
    {
      "start": 27.26,
      "end": 27.54,
      "text": "Leaf."
    },
    {
      "start": 27.58,
      "end": 28.26,
      "text": "He refuses."
    },
    {
      "start": 28.26,
      "end": 30.52,
      "text": "Now, both sides question his"
    },
    {
      "start": 30.52,
      "end": 32.0,
      "text": "loyalty, and the deal that"
    },
    {
      "start": 32.0,
      "end": 33.68,
      "text": "protected his friends falls apart."
    },
    {
      "start": 33.98,
      "end": 35.26,
      "text": "Naruto has to choose."
    },
    {
      "start": 35.64,
      "end": 37.22,
      "text": "Prove himself to the organization,"
    },
    {
      "start": 37.8,
      "end": 39.0,
      "text": "or protect the people who"
    },
    {
      "start": 39.0,
      "end": 40.0,
      "text": "still believe in him."
    },
    {
      "start": 40.06,
      "end": 41.28,
      "text": "Could he change the Akkitsuki"
    },
    {
      "start": 41.28,
      "end": 41.92,
      "text": "from inside?"
    },
    {
      "start": 42.4,
      "end": 43.74,
      "text": "Or would joining them change"
    },
    {
      "start": 43.74,
      "end": 44.6,
      "text": "Naruto first?"
    }
  ]
}

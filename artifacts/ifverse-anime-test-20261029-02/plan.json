  "scenes": [
    {
      "start": 0.0,
      "end": 5.354666666666667,
      "text": "What if Naruto joined the Akatsuki? The first surprise is that joining would not make him safe.",
      "label": "THE WRONG SIDE OF THE STORY",
      "shots": [
        {
          "asset": "18786249",
          "fit": "contain",
          "trim_start": 0,
          "focus_x": 0.5,
          "match_reason": "Naruto thrusts forward: the protagonist and urgent opening question."
        },
        {
          "asset": "pain-naruto-10",
          "fit": "contain",
          "trim_start": 0.2,
          "focus_x": 0.5,
          "match_reason": "The Six Paths in Akatsuki cloaks establish the organization and threat."
        }
      ]
    },
    {
      "start": 5.354666666666667,
      "end": 11.392,
      "text": "He carries the Nine Tails, and the Akatsuki wants the tailed beasts. Their new recruit is also their target.",
      "label": "THE RECRUIT IS ALSO THE TARGET",
      "shots": [
        {
          "asset": "18787233",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "The moving Nine-Tails avatar directly illustrates the beast Naruto carries."
        },
        {
          "asset": "18786244",
          "fit": "contain",
          "trim_start": 0.2,
          "focus_x": 0.5,
          "match_reason": "Masked Obito watches, illustrating the organization targeting Naruto."
        }
      ]
    },
    {
      "start": 11.392,
      "end": 17.514666666666667,
      "text": "In this alternate timeline, Naruto offers a deal: his help, in exchange for protecting his friends.",
      "label": "ONE DANGEROUS DEAL",
      "shots": [
        {
          "asset": "18786193",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "Naruto speaks with resolve, illustrating his invented offer."
        },
        {
          "asset": "naruto-team-7-0",
          "fit": "contain",
          "trim_start": 0,
          "focus_x": 0.5,
          "match_reason": "Naruto, Sakura and Sasuke ready together: the friends he wants protected."
        },
        {
          "asset": "18786238",
          "fit": "contain",
          "trim_start": 0.1,
          "focus_x": 0.5,
          "match_reason": "Kakashi acts to protect allies: the deal is motivated by their safety."
        }
      ]
    },
    {
      "start": 17.514666666666667,
      "end": 22.784,
      "text": "At first, the missions give him the respect he always wanted. But every favor comes with a price.",
      "label": "TRUST COMES WITH A PRICE",
      "shots": [
        {
          "asset": "18786256",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "Naruto surges forward in a moving chakra avatar, illustrating the power and success of his first missions."
        },
        {
          "asset": "sakura-8",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "Naruto and Sakura share a laugh: the acceptance he wants."
        }
      ]
    },
    {
      "start": 22.784,
      "end": 27.605333333333334,
      "text": "The breaking point arrives when his new allies demand that he turn against the Hidden Leaf.",
      "label": "THEN COMES THE DEMAND",
      "shots": [
        {
          "asset": "pain-naruto-1",
          "fit": "contain",
          "trim_start": 1.0,
          "focus_x": 0.5,
          "match_reason": "Pain rises above the Hidden Leaf, connecting the demand to the threatened village."
        },
        {
          "asset": "sakura-0",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "Sakura crouches in village rubble: the people harmed by that choice."
        }
      ]
    },
    {
      "start": 27.605333333333334,
      "end": 33.728,
      "text": "He refuses. Now both sides question his loyalty, and the deal that protected his friends falls apart.",
      "label": "HE REFUSES",
      "shots": [
        {
          "asset": "18787217",
          "fit": "contain",
          "trim_start": 0.2,
          "focus_x": 0.5,
          "match_reason": "Naruto speaks forcefully, illustrating his refusal."
        },
        {
          "asset": "18787221",
          "fit": "contain",
          "trim_start": 0.3,
          "focus_x": 0.5,
          "match_reason": "Masked Obito confronts Naruto, illustrating distrust from his proposed allies."
        }
      ]
    },
    {
      "start": 33.728,
      "end": 39.95733333333333,
      "text": "Naruto has to choose: prove himself to the organization, or protect the people who still believe in him.",
      "label": "CHOOSE A SIDE",
      "shots": [
        {
          "asset": "pain-naruto-10",
          "fit": "contain",
          "trim_start": 0.1,
          "focus_x": 0.5,
          "match_reason": "Akatsuki members advance as an organized force: one side of the choice."
        },
        {
          "asset": "sakura-8",
          "fit": "contain",
          "trim_start": 1.5,
          "focus_x": 0.5,
          "match_reason": "Sakura and Naruto together illustrate the personal bonds at stake."
        },
        {
          "asset": "18786249",
          "fit": "contain",
          "trim_start": 3.0,
          "focus_x": 0.5,
          "match_reason": "Naruto reaches forward decisively: he must act on that choice."
        }
      ]
    },
    {
      "start": 39.95733333333333,
      "end": 44.672,
      "text": "Could he change the Akatsuki from inside? Or would joining them change Naruto first?",
      "label": "WHO CHANGES WHOM?",
      "shots": [
        {
          "asset": "18787218",
          "fit": "contain",
          "trim_start": 1.2,
          "focus_x": 0.5,
          "match_reason": "Kurama roars behind the seal: a visual question about changing from within."
        },
        {
          "asset": "18787224",
          "fit": "contain",
          "trim_start": 1.6,
          "focus_x": 0.5,
          "match_reason": "Naruto confronts the inner space with resolve, holding the closing question."
        }
      ]
    }
  ],

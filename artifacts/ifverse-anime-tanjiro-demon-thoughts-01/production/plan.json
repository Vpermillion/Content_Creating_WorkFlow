  "scenes": [
    {
      "text": "What if Tanjiro could hear demons' thoughts? The universe added notifications with no mute button available.",
      "label": "THE WORST GROUP CHAT",
      "start": 0.0,
      "end": 4.959765297569153,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-tanjiro",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro listening and thinking; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "This is an invented ability. Understanding suffering might help him protect people.",
      "label": "A FAN MADE EXTRA ABILITY",
      "start": 4.959765297569153,
      "end": 8.862810841017044,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-nezuko",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Nezuko as Tanjiro family and empathy context; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Instead, fear and memories arrive together. Welcome to a cursed open-plan office. Terrible acoustics.",
      "label": "TOO MUCH INFORMATION",
      "start": 8.862810841017044,
      "end": 13.754400670578374,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-tanjiro",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro listening and thinking; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Zenitsu asks if it helps, screams. Outstanding. His own emergency broadcast system.",
      "label": "ZENITSU WOULD LIKE TO DECLINE",
      "start": 13.754400670578374,
      "end": 18.15171835708298,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-zenitsu",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Zenitsu reacting to frightening circumstances; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-zenitsu",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Zenitsu reacting to frightening circumstances; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "A demon thinks it means no harm. Reassuring, except hearing a thought doesn't make it reliable.",
      "label": "A DANGEROUS ASSUMPTION",
      "start": 18.15171835708298,
      "end": 22.702430846605196,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-fight",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro protecting people in battle; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Frightened people can hurt others. Confident memories can mislead. Empathy still needs evidence and practical boundaries.",
      "label": "EMPATHY NEEDS EVIDENCE",
      "start": 22.702430846605196,
      "end": 28.565521095278008,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-tanjiro",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro listening and thinking; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Nezuko reminds him why he cares. Someone can deserve compassion without everybody else surrendering their safety.",
      "label": "REMEMBER THE PERSON",
      "start": 28.565521095278008,
      "end": 34.00251466890193,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-nezuko",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Nezuko as Tanjiro family and empathy context; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-nezuko",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Nezuko as Tanjiro family and empathy context; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "He protects bystanders first, then listens. He installed a firewall on that enormous heart.",
      "label": "PROTECT FIRST LISTEN TOO",
      "start": 34.00251466890193,
      "end": 38.280525286392844,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-fight",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro protecting people in battle; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "A hidden memory suggests a missing person's location. He checks instead of trusting blindly. The ability helps.",
      "label": "USE THE DETAIL",
      "start": 38.280525286392844,
      "end": 43.75160659402068,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-tanjiro",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro listening and thinking; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Zenitsu asks if Tanjiro can mute him. Different species, brother. Your volume is a local government issue.",
      "label": "THE COMPLAINT DEPARTMENT",
      "start": 43.75160659402068,
      "end": 49.10338083263481,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-zenitsu",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Zenitsu reacting to frightening circumstances; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-zenitsu",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Zenitsu reacting to frightening circumstances; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-zenitsu",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Zenitsu reacting to frightening circumstances; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        }
      ]
    },
    {
      "text": "Understanding doesn't promise agreement or painless solutions. The new ability changes his choices, not every consequence outside.",
      "label": "NO PERFECT EASY ENDING",
      "start": 49.10338083263481,
      "end": 55.494830958368254,
      "shots": [
        {
          "asset": "ifverse-anime-tanjiro-demon-thoughts-01-fight",
          "fit": "contain",
          "trim_start": 0,
          "match_reason": "Tanjiro protecting people in battle; illustrates this narrated character/action in an invented scenario, not a literal canon event."
        },
        {

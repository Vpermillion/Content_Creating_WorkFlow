  "video_only": true,
  "single_pass": true,
  "enhancement": "anime-light",
  "source_credit": "IFVERSE ANIME / FAN-MADE WHAT-IF",
  "publishing_authorized": false,
  "narration_sha256": "caf19df8df84377c3a2756b83191b655388295a5e2506619db7b6b3b88318d1d",
  "caption_segments": [
    {
      "start": 0,
      "end": 1.0,
      "text": "What if Levi turned cleaning"
    },
    {
      "start": 1.0,
      "end": 2.84,
      "text": "day into a survival drill?"
    },
    {
      "start": 2.84,
      "end": 4.38,
      "text": "The furious man has concerns."
    },
    {
      "start": 4.38,
      "end": 6.46,
      "text": "Eren complains about wasted time."
    },
    {
      "start": 6.46,
      "end": 7.78,
      "text": "Bro wants heroic action but"
    },
    {
      "start": 7.78,
      "end": 9.7,
      "text": "cannot locate the bucket beside him."
    },
    {
      "start": 9.7,
      "end": 10.6,
      "text": "Levi checks a dirty strap"
    },
    {
      "start": 10.6,
      "end": 11.82,
      "text": "and finds wear."
    },
    {
      "start": 11.82,
      "end": 13.38,
      "text": "This isn't about shiny furniture."
    },
    {
      "start": 13.38,
      "end": 14.34,
      "text": "A frayed line doesn't care"
    },
    {
      "start": 14.34,
      "end": 15.98,
      "text": "about freedom speeches."
    },
    {
      "start": 15.98,
      "end": 17.5,
      "text": "Main character energy makes terrible"
    },
    {
      "start": 17.5,
      "end": 19.18,
      "text": "replacement safety equipment."
    },
    {
      "start": 19.18,
      "end": 20.36,
      "text": "Armin understands."
    },
    {
      "start": 20.36,
      "end": 21.48,
      "text": "Cleaning makes them inspect parts"
    },
    {
      "start": 21.48,
      "end": 22.881745903133965,
      "text": "and explain their findings."
    },
    {
      "start": 22.881745903133965,
      "end": 24.461750000000002,
      "text": "Levi moves the supplies."
    },
    {
      "start": 24.461750000000002,
      "end": 25.38175,
      "text": "Find replacements."
    },
    {
      "start": 25.38175,
      "end": 26.441750000000003,
      "text": "Communicate."
    },
    {
      "start": 26.441750000000003,
      "end": 27.381750000000004,
      "text": "Welcome to logistics with aggressive"
    },
    {
      "start": 27.381750000000004,
      "end": 28.58175,
      "text": "eye contact."
    },
    {
      "start": 28.58175,
      "end": 30.621750000000002,
      "text": "Eren volunteers to carry everything."
    },
    {
      "start": 30.621750000000002,
      "end": 32.121750000000006,
      "text": "My guy, one mistake becomes"
    },
    {
      "start": 32.121750000000006,
      "end": 33.50175,
      "text": "the whole squad's problem."
    },
    {
      "start": 33.50175,
      "end": 34.82175,
      "text": "They distribute essentials and check"
    },
    {
      "start": 34.82175,
      "end": 35.841750000000005,
      "text": "each other's gear."
    },
    {
      "start": 35.841750000000005,
      "end": 37.00175,
      "text": "Not flashy."
    },
    {
      "start": 37.00175,
      "end": 38.201750000000004,
      "text": "Neither is surviving because somebody"
    },
    {
      "start": 38.201750000000004,
      "end": 39.16175,
      "text": "checked a buckle."
    },
    {
      "start": 39.16175,
      "end": 40.701750000000004,
      "text": "This doesn't guarantee safety."
    },
    {
      "start": 40.701750000000004,
      "end": 42.58175,
      "text": "It removes avoidable failures."
    },
    {
      "start": 42.58175,
      "end": 43.621750000000006,
      "text": "Those are different claims, and"
    },
    {
      "start": 43.621750000000006,
      "end": 44.41433226009258,
      "text": "Armin knows it."
    },
    {
      "start": 44.41433226009258,
      "end": 45.934312500000004,
      "text": "The lesson is attention."
    },
    {
      "start": 45.934312500000004,
      "end": 47.1543125,
      "text": "Find the boring detail before"
    },
    {
      "start": 47.1543125,
      "end": 48.794312500000004,
      "text": "a crisis makes it exciting."
    },
    {
      "start": 48.794312500000004,
      "end": 50.7343125,
      "text": "Eren finally cleans properly."
    },
    {
      "start": 50.7343125,
      "end": 51.9543125,
      "text": "The bucket receives more character"
    },
    {
      "start": 51.9543125,
      "end": 53.4543125,
      "text": "development than half the speeches"
    },
    {
      "start": 53.4543125,
      "end": 54.3743125,
      "text": "in that room."
    },
    {
      "start": 54.3743125,
      "end": 55.7743125,
      "text": "Levi spots one speck."
    },
    {
      "start": 55.7743125,
      "end": 56.794312500000004,
      "text": "Everybody freezes."
    },
    {
      "start": 56.794312500000004,
      "end": 58.434312500000004,
      "text": "They survived the drill."
    },
    {
      "start": 58.434312500000004,
      "end": 59.854312500000006,
      "text": "Unfortunately, their supervisor has just"
    },
    {
      "start": 59.854312500000006,
      "end": 60.9743125,
      "text": "discovered overtime."
    }
  ]
}

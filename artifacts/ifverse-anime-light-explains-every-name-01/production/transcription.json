  "captions": [
    {
      "start": 0,
      "end": 0.66,
      "text": "What if Light had to"
    },
    {
      "start": 0.66,
      "end": 1.84,
      "text": "explain every name to L"
    },
    {
      "start": 1.84,
      "end": 3.24,
      "text": "before the notebook worked?"
    },
    {
      "start": 3.24,
      "end": 4.54,
      "text": "Mandatory peer review."
    },
    {
      "start": 4.54,
      "end": 5.98,
      "text": "This rule pauses entries."
    },
    {
      "start": 5.98,
      "end": 7.04,
      "text": "Light gives a reason."
    },
    {
      "start": 7.04,
      "end": 7.98,
      "text": "L can challenge it."
    },
    {
      "start": 7.98,
      "end": 9.34,
      "text": "Terrible news for arrogance."
    },
    {
      "start": 9.34,
      "end": 10.78,
      "text": "Light says someone looks guilty."
    },
    {
      "start": 10.78,
      "end": 12.42,
      "text": "My guy, cheekbone analysis isn't"
    },
    {
      "start": 12.42,
      "end": 13.62,
      "text": "a criminal justice system."
    },
    {
      "start": 13.62,
      "end": 15.24,
      "text": "Then he cites online agreement."
    },
    {
      "start": 15.24,
      "end": 15.98,
      "text": "L asks for the original"
    },
    {
      "start": 15.98,
      "end": 17.02,
      "text": "report."
    },
    {
      "start": 17.02,
      "end": 18.1,
      "text": "The god complex needs a"
    },
    {
      "start": 18.1,
      "end": 19.0,
      "text": "bibliography."
    },
    {
      "start": 19.0,
      "end": 20.52,
      "text": "Ryuk watches humans recreate a"
    },
    {
      "start": 20.52,
      "end": 22.66,
      "text": "terrible university group project."
    },
    {
      "start": 22.66,
      "end": 23.620106908176805,
      "text": "Somebody pass the apples."
    },
    {
      "start": 23.620106908176805,
      "end": 25.260125,
      "text": "Light tries a longer speech."
    },
    {
      "start": 25.260125,
      "end": 26.540125,
      "text": "Dramatic breathing doesn't make guesses"
    },
    {
      "start": 26.540125,
      "end": 27.280124999999998,
      "text": "facts."
    },
    {
      "start": 27.280124999999998,
      "end": 28.420125,
      "text": "Incredible discovery."
    },
    {
      "start": 28.420125,
      "end": 29.940125,
      "text": "L compares the explanations."
    },
    {
      "start": 29.940125,
      "end": 31.200125,
      "text": "Why does criticism suddenly count"
    },
    {
      "start": 31.200125,
      "end": 32.060125,
      "text": "as guilt?"
    },
    {
      "start": 32.060125,
      "end": 33.440125,
      "text": "Why is evidence optional?"
    },
    {
      "start": 33.440125,
      "end": 34.660125,
      "text": "Light's justice bends around his"
    },
    {
      "start": 34.660125,
      "end": 35.460125,
      "text": "ego."
    },
    {
      "start": 35.460125,
      "end": 36.900125,
      "text": "Very convenient weather system."
    },
    {
      "start": 36.900125,
      "end": 38.080124999999995,
      "text": "Bro appointed himself the whole"
    },
    {
      "start": 38.080124999999995,
      "end": 38.860125,
      "text": "forecast."
    },
    {
      "start": 38.860125,
      "end": 40.840125,
      "text": "L isn't automatically correct either."
    },
    {
      "start": 40.840125,
      "end": 42.600125,
      "text": "Both geniuses can miss evidence."
    },
    {
      "start": 42.600125,
      "end": 44.23401839167656,
      "text": "The notebook doesn't delete uncertainty."
    },
    {
      "start": 44.23401839167656,
      "end": 45.614000000000004,
      "text": "Their duel becomes defending conclusions"
    },
    {
      "start": 45.614000000000004,
      "end": 47.614000000000004,
      "text": "instead of delivering smug indoor"
    },
    {
      "start": 47.614000000000004,
      "end": 49.234,
      "text": "monologues with stationery."
    },
    {
      "start": 49.234,
      "end": 50.834,
      "text": "Ryuk asks when they'll finish."
    },
    {
      "start": 50.834,
      "end": 52.614000000000004,
      "text": "L requests supporting documents."
    },
    {
      "start": 52.614000000000004,
      "end": 53.894000000000005,
      "text": "Supernatural horror has become an"
    },
    {
      "start": 53.894000000000005,
      "end": 54.854,
      "text": "academic hearing."
    },
    {
      "start": 54.854,
      "end": 56.614000000000004,
      "text": "Light wanted unquestioned authority."
    },
    {
      "start": 56.614000000000004,
      "end": 57.594,
      "text": "His final boss is somebody"
    },
    {
      "start": 57.594,
      "end": 59.574000000000005,
      "text": "calmly asking for evidence."
    },
    {
      "start": 59.574000000000005,
      "end": 60.974000000000004,
      "text": "Source, bro. Show the source."
    }
  ],

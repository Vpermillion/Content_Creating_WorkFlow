      "text": "Incredible."
    },
    {
      "start": 7.26,
      "end": 8.42,
      "text": "Bro unlocked a feature available"
    },
    {
      "start": 8.42,
      "end": 9.98,
      "text": "on most shopping carts."
    },
    {
      "start": 9.98,
      "end": 11.44,
      "text": "He reaches the meeting first."
    },
    {
      "start": 11.44,
      "end": 12.58,
      "text": "Then the enemy base."
    },
    {
      "start": 12.58,
      "end": 13.32,
      "text": "Then the problem."
    },
    {
      "start": 13.32,
      "end": 14.5,
      "text": "His crew isn't there."
    },
    {
      "start": 14.5,
      "end": 16.02,
      "text": "Early doesn't mean invincible."
    },
    {
      "start": 16.02,
      "end": 17.12,
      "text": "He's inside an ambush with"
    },
    {
      "start": 17.12,
      "end": 18.64,
      "text": "three swords and zero emotional"
    },
    {
      "start": 18.64,
      "end": 19.46252667356929,
      "text": "support."
    },
    {
      "start": 19.46252667356929,
      "end": 20.6025,
      "text": "Luffy is still causing trouble"
    },
    {
      "start": 20.6025,
      "end": 21.6625,
      "text": "elsewhere."
    },
    {
      "start": 21.6625,
      "end": 23.1025,
      "text": "We fixed navigation, not the"
    },
    {
      "start": 23.1025,
      "end": 24.822499999999998,
      "text": "crew's relationship with planning."
    },
    {
      "start": 24.822499999999998,
      "end": 26.5625,
      "text": "Zoro spots extra guards."
    },
    {
      "start": 26.5625,
      "end": 27.3625,
      "text": "This time he knows how"
    },
    {
      "start": 27.3625,
      "end": 28.8425,
      "text": "far away his backup is."
    },
    {
      "start": 28.8425,
      "end": 29.7225,
      "text": "So he retreats and marks"
    },
    {
      "start": 29.7225,
      "end": 31.002499999999998,
      "text": "the approach."
    },
    {
      "start": 31.002499999999998,
      "end": 32.8625,
      "text": "Character development arrives wearing earrings"
    },
    {
      "start": 32.8625,
      "end": 34.542500000000004,
      "text": "and refusing eye contact."
    },
    {
      "start": 34.542500000000004,
      "end": 36.2825,
      "text": "He warns Nami. They pick a better route"
    },
    {
      "start": 36.2825,
      "end": 37.542500000000004,
      "text": "and arrive together."
    },
    {
      "start": 37.542500000000004,
      "end": 38.7425,
      "text": "The enemies lose their easiest"
    },
    {
      "start": 38.7425,
      "end": 39.61547855032369,
      "text": "advantage."
    },
    {
      "start": 39.61547855032369,
      "end": 40.5555,
      "text": "Now he fights with cover"
    },
    {
      "start": 40.5555,
      "end": 41.9355,
      "text": "instead of auditioning for a"
    },
    {
      "start": 41.9355,
      "end": 43.4555,
      "text": "cautionary flashback."
    },
    {
      "start": 43.4555,
      "end": 44.9955,
      "text": "Timing beats stubbornness here."
    },
    {
      "start": 44.9955,
      "end": 46.8155,
      "text": "He still argues with instructions."
    },
    {
      "start": 46.8155,
      "end": 47.9755,
      "text": "His complaints reach the correct"
    },
    {
      "start": 47.9755,
      "end": 48.695499999999996,
      "text": "address."
    },
    {
      "start": 48.695499999999996,
      "end": 50.1155,
      "text": "Nami buys a compass."
    },
    {
      "start": 50.1155,
      "end": 51.155499999999996,
      "text": "Zoro asks if it comes"
    },
    {
      "start": 51.155499999999996,
      "end": 52.3955,
      "text": "in sword form."
    },
    {
      "start": 52.3955,
      "end": 54.6355,
      "text": "Navigation needs a damage stat, apparently."
    },
    {
      "start": 54.6355,
      "end": 56.195499999999996,
      "text": "They finally travel together."
    },
    {
      "start": 56.195499999999996,
      "end": 57.2155,
      "text": "Luffy points toward the wrong"
    },
    {
      "start": 57.2155,
      "end": 58.2955,
      "text": "island."
    },
    {
      "start": 58.2955,
      "end": 58.9955,
      "text": "Excellent."
    },
    {
      "start": 58.9955,
      "end": 60.9755,
      "text": "The navigation disease found another host."
    }
  ]
}

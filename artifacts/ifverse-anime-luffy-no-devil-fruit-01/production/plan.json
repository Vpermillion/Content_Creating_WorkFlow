    }
  ],
  "video_only": true,
  "single_pass": true,
  "enhancement": "anime-light",
  "source_credit": "IFVERSE ANIME / FAN-MADE WHAT-IF",
  "publishing_authorized": false,
  "narration_sha256": "2ccd7bac0d0275779b7fb254cc1f3d9aee3932912ee14556637e03c7fa69af3f",
  "caption_segments": [
    {
      "start": 0,
      "end": 0.82,
      "text": "What if Luffy never ate"
    },
    {
      "start": 0.82,
      "end": 1.82,
      "text": "a Devil Fruit?"
    },
    {
      "start": 1.82,
      "end": 3.2,
      "text": "Same pirate dream."
    },
    {
      "start": 3.2,
      "end": 5.24,
      "text": "Dramatically fewer elastic escape plans."
    },
    {
      "start": 5.24,
      "end": 6.48,
      "text": "In this timeline, Shanks keeps"
    },
    {
      "start": 6.48,
      "end": 7.72,
      "text": "the fruit away."
    },
    {
      "start": 7.72,
      "end": 9.4,
      "text": "Somebody finally installed childproofing on"
    },
    {
      "start": 9.4,
      "end": 10.08,
      "text": "the plot."
    },
    {
      "start": 10.08,
      "end": 11.16,
      "text": "Luffy keeps swimming."
    },
    {
      "start": 11.16,
      "end": 12.8,
      "text": "Useful, honestly."
    },
    {
      "start": 12.8,
      "end": 14.28,
      "text": "Revolutionary technology called not immediately"
    },
    {
      "start": 14.28,
      "end": 15.68,
      "text": "drowning after you leave."
    },
    {
      "start": 15.68,
      "end": 17.18,
      "text": "But his body isn't rubber."
    },
    {
      "start": 17.18,
      "end": 18.18,
      "text": "Bullets won't bounce because he's"
    },
    {
      "start": 18.18,
      "end": 19.0,
      "text": "built different."
    },
    {
      "start": 19.0,
      "end": 19.7,
      "text": "Be serious."
    },
    {
      "start": 19.7,
      "end": 21.22,
      "text": "He needs different training, defense,"
    },
    {
      "start": 21.22,
      "end": 22.14,
      "text": "and discipline."
    },
    {
      "start": 22.14,
      "end": 23.16,
      "text": "Shanks isn't issuing a victory"
    },
    {
      "start": 23.16,
      "end": 23.91213732085972,
      "text": "certificate."
    },
    {
      "start": 23.91213732085972,
      "end": 25.252125,
      "text": "The crew matters more."
    },
    {
      "start": 25.252125,
      "end": 26.652125,
      "text": "Zoro covers combat while somebody"
    },
    {
      "start": 26.652125,
      "end": 28.232125,
      "text": "explains that cannons aren't just"
    },
    {
      "start": 28.232125,
      "end": 29.752125,
      "text": "motivational obstacles."
    },
    {
      "start": 29.752125,
      "end": 31.472125000000002,
      "text": "Luffy still leaps toward danger."
    },
    {
      "start": 31.472125000000002,
      "end": 32.452125,
      "text": "We removed the fruit, not"
    },
    {
      "start": 32.452125,
      "end": 34.092125,
      "text": "his adventurous single brain cell."
    },
    {
      "start": 34.092125,
      "end": 36.212125,
      "text": "Positioning and tools become essential."
    },
    {
      "start": 36.212125,
      "end": 37.192125000000004,
      "text": "A rope extends your reach"
    },
    {
      "start": 37.192125000000004,
      "end": 39.372125,
      "text": "without a supernatural childhood accident."
    },
    {
      "start": 39.372125,
      "end": 41.192125000000004,
      "text": "Then a crewmate falls overboard."
    },
    {
      "start": 41.192125000000004,
      "end": 42.312125,
      "text": "Luffy can finally help instead"
    },
    {
      "start": 42.312125,
      "end": 43.512125,
      "text": "of becoming the second rescue"
    },
    {
      "start": 43.512125,
      "end": 44.16530535339823,
      "text": "objective."
    },
    {
      "start": 44.16530535339823,
      "end": 44.8853125,
      "text": "The trade?"
    },
    {
      "start": 44.8853125,
      "end": 46.9853125,
      "text": "Extraordinary flexibility disappears, but an"
    },
    {
      "start": 46.9853125,
      "end": 48.5653125,
      "text": "ordinary ability changes how he"
    },
    {
      "start": 48.5653125,
      "end": 49.4853125,
      "text": "protects friends."
    },
    {
      "start": 49.4853125,
      "end": 50.7853125,
      "text": "Some battles become harder or"
    },
    {
      "start": 50.7853125,
      "end": 51.7053125,
      "text": "unwinnable."
    },
    {
      "start": 51.7053125,
      "end": 52.925312500000004,
      "text": "Plot armor isn't a documented"
    },
    {
      "start": 52.925312500000004,
      "end": 54.2053125,
      "text": "training program."
    },
    {
      "start": 54.2053125,
      "end": 55.4453125,
      "text": "Please show your sources."
    },
    {
      "start": 55.4453125,
      "end": 56.5453125,
      "text": "The dream survives."
    },
    {
      "start": 56.5453125,
      "end": 57.8253125,
      "text": "The crew matters more."
    },
    {
      "start": 57.8253125,
      "end": 58.965312499999996,
      "text": "And the captain's relationship with"
    },
    {
      "start": 58.965312499999996,
      "end": 60.965312499999996,
      "text": "water stops being legally binding beef."
    }
  ]
}

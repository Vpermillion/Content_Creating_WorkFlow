    },
    {
      "text": "The dream survives. The crew matters more. And the captain's relationship with water stops being legally binding beef.",
      "label": "THE DREAM SURVIVES",
      "start": 55.39988711190559,
      "end": 61.0,
      "shots": [
        {
          "asset": "ifverse-anime-luffy-no-devil-fruit-01-crew",

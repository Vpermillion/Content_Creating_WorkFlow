  "single_pass": true,
  "enhancement": "anime-light",
  "source_credit": "IFVERSE ANIME / FAN-MADE WHAT-IF",
  "publishing_authorized": false,
  "narration_sha256": "9419ae67a2c91e36e4d03bfb37bf9dbcf7e36295527e5c4856ad3f5342cd1f27",
  "caption_segments": [
    {
      "start": 0,
      "end": 0.96,
      "text": "What if Gojo lost his"
    },
    {
      "start": 0.96,
      "end": 1.98,
      "text": "powers for a day?"
    },
    {
      "start": 1.98,
      "end": 3.16,
      "text": "The confidence stays."
    },
    {
      "start": 3.16,
      "end": 4.4,
      "text": "The backup plan has vanished."
    },
    {
      "start": 4.4,
      "end": 5.72,
      "text": "This hypothetical disables his technique"
    },
    {
      "start": 5.72,
      "end": 7.3,
      "text": "for twenty -four hours."
    },
    {
      "start": 7.3,
      "end": 8.14,
      "text": "No upgrade."
    },
    {
      "start": 8.14,
      "end": 9.04,
      "text": "Use the syllabus."
    },
    {
      "start": 9.04,
      "end": 10.44,
      "text": "Yuji suggests hiding him."
    },
    {
      "start": 10.44,
      "end": 11.74,
      "text": "Gojo calls it a lesson."
    },
    {
      "start": 11.74,
      "end": 13.12,
      "text": "My guy, impressive rebrand for"
    },
    {
      "start": 13.12,
      "end": 13.78,
      "text": "embarrassment."
    },
    {
      "start": 13.78,
      "end": 14.76,
      "text": "Megumi asks who knows he's"
    },
    {
      "start": 14.76,
      "end": 15.56,
      "text": "vulnerable."
    },
    {
      "start": 15.56,
      "end": 16.32,
      "text": "Announcing it?"
    },
    {
      "start": 16.32,
      "end": 18.12,
      "text": "A beautifully stupid marketing campaign."
    },
    {
      "start": 18.12,
      "end": 20.1,
      "text": "Gojo keeps experience and judgment."
    },
    {
      "start": 20.1,
      "end": 21.16,
      "text": "We removed a technique, not"
    },
    {
      "start": 21.16,
      "end": 21.96,
      "text": "his brain."
    },
    {
      "start": 21.96,
      "end": 23.439814814814817,
      "text": "No personality factory reset."
    },
    {
      "start": 23.439814814814817,
      "end": 24.6798125,
      "text": "They change the objective."
    },
    {
      "start": 24.6798125,
      "end": 26.4198125,
      "text": "Evacuate people, limit exposure, avoid"
    },
    {
      "start": 26.4198125,
      "end": 27.5198125,
      "text": "direct fights."
    },
    {
      "start": 27.5198125,
      "end": 28.6998125,
      "text": "Reach tomorrow intact."
    },
    {
      "start": 28.6998125,
      "end": 29.7798125,
      "text": "Yuji wants to rescue everyone"
    },
    {
      "start": 29.7798125,
      "end": 30.5998125,
      "text": "alone."
    },
    {
      "start": 30.5998125,
      "end": 32.0398125,
      "text": "Strong instincts, brother."
    },
    {
      "start": 32.0398125,
      "end": 33.399812499999996,
      "text": "Terrible delivery policy for handing"
    },
    {
      "start": 33.399812499999996,
      "end": 34.5398125,
      "text": "yourself to enemies."
    },
    {
      "start": 34.5398125,
      "end": 35.4398125,
      "text": "A threat appears."
    },
    {
      "start": 35.4398125,
      "end": 36.4598125,
      "text": "Instead of overpowering it, they"
    },
    {
      "start": 36.4598125,
      "end": 37.9398125,
      "text": "use a decoy and escape route."
    },
    {
      "start": 37.9398125,
      "end": 39.2798125,
      "text": "Megumi handles the route."
    },
    {
      "start": 39.2798125,
      "end": 40.399812499999996,
      "text": "Yuji moves people."
    },
    {
      "start": 40.399812499999996,
      "end": 41.8798125,
      "text": "Gojo calls timing."
    },
    {
      "start": 41.8798125,
      "end": 43.57380174291939,
      "text": "Students become participants, not spectators."
    },
    {
      "start": 43.57380174291939,
      "end": 45.4538125,
      "text": "Gojo must trust his teaching."
    },
    {
      "start": 45.4538125,
      "end": 46.3538125,
      "text": "Incredible."
    },
    {
      "start": 46.3538125,
      "end": 47.3538125,
      "text": "Education has reached its terrifying"
    },
    {
      "start": 47.3538125,
      "end": 48.933812499999995,
      "text": "practical application."
    },
    {
      "start": 48.933812499999995,
      "end": 50.19381249999999,
      "text": "Somebody check the syllabus."
    },
    {
      "start": 50.19381249999999,
      "end": 51.69381249999999,
      "text": "The powers return tomorrow."
    },
    {
      "start": 51.69381249999999,
      "end": 53.0138125,
      "text": "The lesson remains: your team"
    },
    {
      "start": 53.0138125,
      "end": 54.2338125,
      "text": "shouldn't collapse because its strongest"
    },
    {
      "start": 54.2338125,
      "end": 55.1538125,
      "text": "member struggles."
    },
    {
      "start": 55.1538125,
      "end": 57.3138125,
      "text": "Gojo claims everything was intentional."
    },
    {
      "start": 57.3138125,
      "end": 59.033812499999996,
      "text": "Megumi requests the lesson plan."
    },
    {
      "start": 59.033812499999996,
      "end": 59.83381249999999,
      "text": "The receipts have entered the"
    },
    {
      "start": 59.83381249999999,
      "end": 60.973812499999994,
      "text": "domain, undefeated."
    }
  ]
}

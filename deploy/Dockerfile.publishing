# syntax=docker/dockerfile:1
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core espeak-ng && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-youtube.txt requirements-youtube-publish.txt requirements-test-video.txt ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir -r requirements-youtube.txt -r requirements-youtube-publish.txt -r requirements-test-video.txt
COPY whatif ./whatif
COPY scripts ./scripts
COPY channels ./channels
COPY review-requests ./review-requests
COPY pilots ./pilots
COPY edits ./edits
COPY assets ./assets
RUN useradd --uid 10001 --create-home publisher && mkdir /state && chown publisher /state
USER publisher
ENV IFVERSE_ROOT=/app IFVERSE_STATE=/state PORT=8080
EXPOSE 8080
CMD ["python", "-m", "whatif.publishing_api"]

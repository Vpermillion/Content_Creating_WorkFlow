{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whatif:job:1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "channel_id",
    "language",
    "title",
    "profile",
    "scenes",
    "sources",
    "assumptions",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "channel_id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 90
    },
    "profile": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "min_seconds",
        "max_seconds"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "text",
          "visual",
          "label"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "publisher",
          "supports",
          "checked_at",
          "access_status"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "youtube",
          "tiktok",
          "instagram",
          "facebook"
        ]
      }
    }
  }
}

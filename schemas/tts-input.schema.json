{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whatif:tts-input:1",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "job_id",
          "content_version",
          "language",
          "voice",
          "segments"
        ]
      }
    }
  }
}
